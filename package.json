{
  "name": "rwanda-htmx-performance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "css:build": "bunx @tailwindcss/cli -i ./assets/input.css -o ./static/app.css --minify",
    "css:watch": "bunx @tailwindcss/cli -i ./assets/input.css -o ./static/app.css --watch",
    "dev": "concurrently --kill-others-on-fail --names CSS,ACTIX --prefix-colors cyan,green \"bun run css:watch\" \"cargo run\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "latest",
    "concurrently": "latest",
    "daisyui": "latest",
    "tailwindcss": "latest"
  }
}
